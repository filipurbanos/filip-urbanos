# Public site URL (sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://filipurbanos.com

# Required in production. Locally, defaults exist for convenience — change them.
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Durable CMS storage (Vercel Blob). When set, content.json + uploads + auth
# live in Blob instead of the local filesystem. Create a Blob store in the
# Vercel dashboard and paste the token here (also on the Vercel project).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# Optional override: CMS_DRIVER=fs | blob
# (default: blob when BLOB_READ_WRITE_TOKEN is set, otherwise fs)
