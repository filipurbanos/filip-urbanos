# Public site URL (sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://filip-urbanos.vercel.app

# Required in production. Locally, defaults exist for convenience — change them.
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Durable CMS storage (Vercel Blob). When set, content.json + uploads + auth
# live in Blob instead of the local filesystem. Create a Blob store in the
# Vercel dashboard and paste the token here (also on the Vercel project).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# Optional override: CMS_DRIVER=fs | blob
# (default: blob when BLOB_READ_WRITE_TOKEN is set, otherwise fs)
#
# Auto-seed empty Blob from data/content.json is ON in development only.
# Set CMS_ALLOW_SEED=1 to allow it in production (avoid unless intentional).
# CMS_ALLOW_SEED=1
#
# Optional: notify on new contact form submissions (best-effort).
# Slack Incoming Webhook URL
# CONTACT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Or email via Resend (https://resend.com)
# RESEND_API_KEY=re_...
# CONTACT_NOTIFY_TO=you@example.com
# CONTACT_NOTIFY_FROM="Filip Urbanos <noreply@yourdomain.com>"

